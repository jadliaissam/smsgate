<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Platform theme only (no AppCompat): Compose draws everything; this just
         paints the canvas colour before the first frame. -->
    <style name="Theme.SmsGate" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/token_canvas</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
