# SMSGate backend configuration. Every value shown is the default.
# DATABASE_URL is required.
HTTP_ADDR=:8080
DATABASE_URL=postgres://smsgate:smsgate@localhost:5432/smsgate?sslmode=disable
APP_ENV=prod
PUBLIC_URL=http://localhost:8080
LOG_LEVEL=info
DB_MAX_CONNS=10
DB_MIN_CONNS=1
DB_MAX_CONN_IDLE_TIME=5m
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=120s
SHUTDOWN_TIMEOUT=10s
MAX_BODY_BYTES=16384
MSG_TTL_DEFAULT=300s
MSG_TTL_MIN=10s
MSG_TTL_MAX=3600s
MSG_MAX_SEGMENTS=3
LIST_LIMIT_DEFAULT=50
LIST_LIMIT_MAX=200
PENDING_LIMIT=50
PAIRING_CODE_TTL=5m
DEVICE_ONLINE_WINDOW=2m
DEVICE_LOST_AFTER=15m
SWEEP_INTERVAL=2s
SWEEP_BATCH=500
ARGON2_MEMORY_KIB=19456
ARGON2_TIME=2
ARGON2_THREADS=1
ARGON2_MAX_CONCURRENCY=2
PASSWORD_MIN_LEN=10
PASSWORD_MAX_LEN=128
SESSION_TTL=720h
SESSION_COOKIE_NAME=sg_session
# Defaults to false when APP_ENV=dev
COOKIE_SECURE=true
EMAIL_TOKEN_TTL=24h
APIKEY_TOUCH_INTERVAL=1m
# Empty means push wake-ups are disabled (noop waker)
FCM_CREDENTIALS_FILE=
FCM_ENDPOINT=https://fcm.googleapis.com
WAKE_CONCURRENCY=64
WAKE_TIMEOUT=5s
FCM_HTTP_MAX_IDLE_PER_HOST=16
# Go runtime (not read by config): GOMEMLIMIT=96MiB, GOGC=100
