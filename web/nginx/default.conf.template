# Rendered by the nginx image entrypoint (envsubst, filtered to BACKEND_URL,
# NGINX_RESOLVER and APK_DOWNLOAD_URL). A variable proxy_pass plus resolver
# lets nginx start before the API container exists and re-resolve its address
# as it changes.

map $http_x_forwarded_proto $fwd_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      "";
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    set $backend "${BACKEND_URL}";

    gzip on;
    gzip_vary on;
    gzip_min_length 256;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/javascript application/javascript application/json image/svg+xml;

    # Every location includes snippets/security.conf itself: nginx does not
    # inherit add_header from the server level once a location adds its own.

    # Upstream read timeout for proxied API calls; /device/ overrides it (set
    # here, not in proxy.conf, since a location may not repeat the directive).
    proxy_read_timeout 75s;

    location ~ ^/(app|v1)/ {
        include /etc/nginx/snippets/security.conf;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass $backend;
    }

    # Device API, including the WebSocket GET /device/v1/ws: an idle socket
    # carries a client ping every 5 minutes, so both directions may stay
    # silent that long (the API closes sockets silent past WS_PING_TIMEOUT=6m).
    location /device/ {
        include /etc/nginx/snippets/security.conf;
        include /etc/nginx/snippets/proxy.conf;
        proxy_read_timeout 7m;
        proxy_send_timeout 7m;
        proxy_pass $backend;
    }

    location = /healthz {
        include /etc/nginx/snippets/security.conf;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass $backend;
    }

    location /assets/ {
        include /etc/nginx/snippets/security.conf;
        # No "always": a 404 for a missing chunk must not be cached for a year.
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Build revision (git sha), checked by CI after a deploy.
    location = /revision.txt {
        include /etc/nginx/snippets/security.conf;
        add_header Cache-Control "no-store" always;
        default_type text/plain;
        try_files $uri =404;
    }

    location = /index.html {
        include /etc/nginx/snippets/security.conf;
        add_header Cache-Control "no-cache" always;
    }

    # The Android APK is published as a GitHub Release asset; send the
    # dashboard's download link there. no-store so a new release is picked up
    # at once (the target URL stays the same, the asset behind it changes).
    location = /downloads/smsgate.apk {
        include /etc/nginx/snippets/security.conf;
        add_header Cache-Control "no-store" always;
        return 302 "${APK_DOWNLOAD_URL}";
    }

    # Other downloads, from a mounted volume.
    location /downloads/ {
        alias /usr/share/nginx/downloads/;
        autoindex off;
        include /etc/nginx/snippets/security.conf;
    }

    location / {
        include /etc/nginx/snippets/security.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
