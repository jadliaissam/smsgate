# Rendered by the nginx image entrypoint (envsubst, filtered to BACKEND_URL and
# NGINX_RESOLVER). A variable proxy_pass plus resolver lets nginx start before
# the API container exists and re-resolve its address as it changes.

map $http_x_forwarded_proto $fwd_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      "";
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    set $backend "${BACKEND_URL}";

    gzip on;
    gzip_vary on;
    gzip_min_length 256;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/javascript application/javascript application/json image/svg+xml;

    # Every location includes snippets/security.conf itself: nginx does not
    # inherit add_header from the server level once a location adds its own.

    location ~ ^/(app|v1|device)/ {
        include /etc/nginx/snippets/security.conf;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass $backend;
    }

    location = /healthz {
        include /etc/nginx/snippets/security.conf;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass $backend;
    }

    location /assets/ {
        include /etc/nginx/snippets/security.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location = /index.html {
        include /etc/nginx/snippets/security.conf;
        add_header Cache-Control "no-cache" always;
    }

    location /downloads/ {
        alias /usr/share/nginx/downloads/;
        autoindex off;
        include /etc/nginx/snippets/security.conf;
    }

    location / {
        include /etc/nginx/snippets/security.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
